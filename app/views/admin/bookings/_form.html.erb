<% if booking.errors.any? %>
  <div class="error-list">
    <% booking.errors.full_messages.each do |msg| %>
      <div><%= msg %></div>
    <% end %>
  </div>
<% end %>

<%= form_with model: booking, url: url, local: true do |f| %>
  <div class="field-row">
    <div class="field">
      <%= f.label :client_name, "Client name" %>
      <%= f.text_field :client_name %>
    </div>
    <div class="field">
      <%= f.label :client_email, "Client email" %>
      <%= f.email_field :client_email %>
    </div>
  </div>

  <div class="field">
    <%= f.label :starts_at, "Date & time" %>
    <%= f.datetime_field :starts_at, value: booking.starts_at&.strftime("%Y-%m-%dT%H:%M") %>
    <p class="muted" style="font-size:12.5px; margin-top:6px;">30-minute call, Muscat time. Booking a time that's already taken will show an error.</p>
  </div>

  <div class="field">
    <%= f.label :note, "Note (optional)" %>
    <%= f.text_area :note, rows: 3 %>
  </div>

  <%= f.submit submit_label, class: "btn btn-primary" %>
  <%= link_to "Cancel", admin_bookings_path, class: "btn btn-ghost" %>
<% end %>
