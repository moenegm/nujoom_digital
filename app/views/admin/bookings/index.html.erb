<div class="admin-nav" style="margin-bottom:22px;">
  <h1 style="margin:0;">Bookings</h1>
  <%= link_to "+ New booking", new_admin_booking_path, class: "btn btn-primary" %>
</div>

<h2 style="font-size:15px; color:var(--gold-bright, var(--gold)); margin-bottom:10px;">Upcoming</h2>
<% if @upcoming.any? %>
  <table>
    <thead>
      <tr>
        <th>When</th>
        <th>Client</th>
        <th>Note</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @upcoming.each do |booking| %>
        <tr>
          <td data-label="When"><%= booking.starts_at.strftime("%a, %b %-d · %-I:%M %p") %></td>
          <td data-label="Client">
            <%= booking.client_name %><br>
            <span class="muted"><%= booking.client_email %></span>
          </td>
          <td data-label="Note" class="muted"><%= truncate(booking.note, length: 60) if booking.note.present? %></td>
          <td data-label="Actions">
            <div class="actions">
              <%= link_to "Edit", edit_admin_booking_path(booking), class: "btn btn-ghost" %>
              <%= button_to "Cancel", admin_booking_path(booking), method: :delete, class: "btn btn-danger",
                    form: { data: { turbo_confirm: "Cancel this booking? The client will be emailed." } } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="muted">No upcoming bookings right now.</p>
<% end %>

<h2 style="font-size:15px; color:var(--gold-bright, var(--gold)); margin-bottom:10px;">Recent past</h2>
<% if @past.any? %>
  <table>
    <thead>
      <tr>
        <th>When</th>
        <th>Client</th>
        <th>Note</th>
      </tr>
    </thead>
    <tbody>
      <% @past.each do |booking| %>
        <tr>
          <td data-label="When" class="muted"><%= booking.starts_at.strftime("%a, %b %-d · %-I:%M %p") %></td>
          <td data-label="Client" class="muted"><%= booking.client_name %> · <%= booking.client_email %></td>
          <td data-label="Note" class="muted"><%= truncate(booking.note, length: 60) if booking.note.present? %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="muted">Nothing yet.</p>
<% end %>
