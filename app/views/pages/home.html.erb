<script>
(function() {
  const root = document;
  root.getElementById('year').textContent = new Date().getFullYear();

  const TIMES = [
    { key: '10:00', label: '10:00 AM' },
    { key: '13:00', label: '1:00 PM' },
    { key: '15:30', label: '3:30 PM' },
  ];

  function nextBusinessDays(count) {
    const days = [];
    let d = new Date();
    d.setDate(d.getDate() + 1); // start tomorrow
    while (days.length < count) {
      const day = d.getDay();
      if (day !== 0 && day !== 6) {
        days.push(new Date(d));
      }
      d.setDate(d.getDate() + 1);
    }
    return days;
  }

  function fmtDate(d) {
    return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
  }
  function isoDate(d) {
    return d.toISOString().slice(0, 10);
  }

  const days = nextBusinessDays(6);
  const dayCol = root.getElementById('dayCol');
  let bookings = [];
  let selected = null; // { date, time, label }

  function slotTaken(dateIso, timeKey) {
    return bookings.some(b => b.date === dateIso && b.time === timeKey);
  }

  function render() {
    dayCol.innerHTML = '';
    days.forEach(d => {
      const iso = isoDate(d);
      const block = document.createElement('div');
      block.className = 'day-block';

      const head = document.createElement('div');
      head.className = 'day-block-head';
      head.innerHTML = `<span>${fmtDate(d)}</span>`;
      block.appendChild(head);

      const row = document.createElement('div');
      row.className = 'slot-row';

      TIMES.forEach(t => {
        const taken = slotTaken(iso, t.key);
        const btn = document.createElement('button');
        btn.className = 'slot-btn';
        btn.disabled = taken;
        btn.innerHTML = `<span class="t mono">${t.label}</span><span class="s">${taken ? 'Booked' : 'Open'}</span>`;
        if (selected && selected.date === iso && selected.time === t.key) {
          btn.classList.add('selected');
        }
        btn.addEventListener('click', () => {
          selected = { date: iso, time: t.key, label: `${fmtDate(d)} · ${t.label} PT` };
          render();
          showForm();
        });
        row.appendChild(btn);
      });

      block.appendChild(row);
      dayCol.appendChild(block);
    });
  }

  const bookForm = root.getElementById('bookForm');
  const selectedSlotLabel = root.getElementById('selectedSlotLabel');
  const bkError = root.getElementById('bkError');
  const bookConfirm = root.getElementById('bookConfirm');

  function showForm() {
    bookForm.classList.add('show');
    bookConfirm.classList.remove('show');
    bkError.classList.remove('show');
    selectedSlotLabel.textContent = selected.label;
    bookForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  async function loadBookings() {
    bookings = [];
    render();
  }
  
  root.getElementById('bkSubmit').addEventListener('click', async () => {
    const name = root.getElementById('bkName').value.trim();
    const email = root.getElementById('bkEmail').value.trim();
    const note = root.getElementById('bkNote').value.trim();
    const emailOk = /\S+@\S+\.\S+/.test(email);

    if (!name || !emailOk || !selected) {
      bkError.classList.add('show');
      return;
    }
    bkError.classList.remove('show');

    try {
      await window.storage.set('bookings-v1', JSON.stringify(bookings), true);
    } catch (e) {
      bkError.textContent = 'Something went wrong saving your booking — please try again.';
      bkError.classList.add('show');
      return;
    }

    if (slotTaken(selected.date, selected.time)) {
      bkError.textContent = 'Sorry — that slot was just taken. Pick another.';
      bkError.classList.add('show');
      selected = null;
      render();
      bookForm.classList.remove('show');
      return;
    }

    bookings.push({
      date: selected.date,
      time: selected.time,
      name, email, note,
      bookedAt: new Date().toISOString()
    });

    try {
      await window.storage.set('bookings-v1', JSON.stringify(bookings), true);
    } catch (e) {
      bkError.textContent = 'Something went wrong saving your booking — please try again.';
      bkError.classList.add('show');
      return;
    }

    bookConfirm.textContent = `You're booked for ${selected.label}. A confirmation would normally be emailed to ${email} — for now, reach out at mr.negm90@gmail.com to lock it in on my end.`;
    bookConfirm.classList.add('show');
    bookForm.classList.remove('show');
    root.getElementById('bkName').value = '';
    root.getElementById('bkEmail').value = '';
    root.getElementById('bkNote').value = '';
    selected = null;
    render();
  });

  loadBookings();

  // Contact form → mailto
  const contactForm = root.getElementById('contactForm');
  const fallbackLink = root.getElementById('fallbackLink');
  contactForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = root.getElementById('cName').value.trim();
    const email = root.getElementById('cEmail').value.trim();
    const message = root.getElementById('cMessage').value.trim();
    if (!name || !email || !message) return;

    const subject = encodeURIComponent(`New project inquiry from ${name}`);
    const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`);
    const mailto = `mailto:mr.negm90@gmail.com?subject=${subject}&body=${body}`;

    window.open(mailto, '_blank');
    fallbackLink.href = mailto;
    fallbackLink.classList.add('show');
  });
})();
</script>