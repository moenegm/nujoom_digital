          <polygon points="150,10 90,80 210,80" fill="#c9a66b"/>
          <polygon points="90,80 150,10 40,110" fill="#9b1b30"/>
          <polygon points="210,80 150,10 260,110" fill="#b8233f"/>
          <polygon points="40,110 90,80 150,150 150,190" fill="#7a1626" class="shine"/>
          <polygon points="260,110 210,80 150,150 150,190" fill="#d42a4c" class="shine"/>
