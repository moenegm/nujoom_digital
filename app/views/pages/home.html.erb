        <svg class="facet-mini" viewBox="0 0 24 24" fill="none"><path d="M12 2L4 9l8 13 8-13-8-7z" fill="#d42a4c"/><path d="M12 2L4 9h16L12 2z" fill="#c9a66b"/></svg>
