<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');

  :root{
    --ink:#0d1a30;
    --panel:#152642;
    --panel-2:#1b3050;
    --gold:#c9a04c;
    --gold-bright:#e0bd6e;
    --paper:#ece7da;
    --paper-dim:#a9b3c6;
    --cream:#f2e5c4;
    --line: rgba(242,229,196,0.12);
    --radius: 2px;
  }

  * { box-sizing: border-box; }

  .nujoom-site {
    background: var(--ink);
    color: var(--paper);
    font-family: 'Inter', sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .nujoom-site h1, .nujoom-site h2, .nujoom-site h3 {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--paper);
    margin: 0;
  }
  .nujoom-site a { color: inherit; }
  .nujoom-site .mono { font-family: 'JetBrains Mono', monospace; letter-spacing: 0.02em; }
  .nujoom-site button, .nujoom-site input, .nujoom-site textarea {
    font-family: inherit;
  }
  .nujoom-site :focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 28px; }

  /* NAV */
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(18,16,20,0.86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner { display:flex; align-items:center; justify-content:space-between; padding: 16px 28px; max-width: 1080px; margin: 0 auto; }
  .brand { font-family:'Fraunces',serif; font-weight:600; font-size:18px; display:flex; align-items:center; gap:10px; }
  .brand .facet-mini { width:14px; height:14px; flex-shrink:0; }
  .nav-links { display:flex; gap:28px; font-size:14px; }
  .nav-links a { text-decoration:none; color: var(--paper-dim); transition: color .2s; }
  .nav-links a:hover { color: var(--gold); }

  /* HERO */
  .hero { position:relative; padding: 100px 0 90px; overflow:hidden; }
  .hero-grid { display:grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items:center; }
  .eyebrow {
    font-family:'JetBrains Mono', monospace; font-size:12px; letter-spacing:0.14em; text-transform:uppercase;
    color: var(--gold); margin-bottom: 18px; display:block;
  }
  .hero h1 { font-size: clamp(34px, 5vw, 56px); line-height: 1.05; }
  .hero h1 em { font-style:normal; color: var(--gold-bright); }
  .hero p.lead { color: var(--paper-dim); font-size: 18px; max-width: 46ch; margin-top: 20px; }
  .hero-ctas { display:flex; gap:14px; margin-top: 34px; flex-wrap:wrap; }

  .btn {
    display:inline-flex; align-items:center; gap:8px;
    padding: 13px 24px; border-radius: var(--radius); border: 1px solid transparent;
    font-size: 14px; font-weight:600; cursor:pointer; text-decoration:none;
    transition: transform .15s ease, background .2s ease, border-color .2s ease;
  }
  .btn:active { transform: translateY(1px); }
  .btn-primary { background: var(--gold); color: var(--ink); font-weight:700; }
  .btn-primary:hover { background: var(--gold-bright); }
  .btn-ghost { border-color: var(--line); color: var(--paper); background: transparent; }
  .btn-ghost:hover { border-color: var(--gold); color: var(--gold); }

  .facet-wrap { position:relative; display:flex; justify-content:center; align-items:center; }
  .facet-gem { width: min(340px, 80%); height:auto; border-radius:50%; filter: drop-shadow(0 30px 60px rgba(201,160,76,0.35)); }

  /* SECTION SHELL */
  section { padding: 84px 0; border-top: 1px solid var(--line); }
  .section-head { max-width: 640px; margin-bottom: 48px; }
  .section-head .eyebrow { margin-bottom: 12px; }
  .section-head h2 { font-size: clamp(26px, 3.4vw, 36px); }
  .section-head p { color: var(--paper-dim); margin-top: 14px; font-size: 16px; }

  /* CAPABILITIES */
  .cap-grid { display:grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .cap-card { background: var(--panel); padding: 30px 26px; }
  .cap-icon { width:32px; height:32px; color: var(--gold); display:block; margin-bottom:18px; }
  .cap-card h3 { font-size: 19px; margin-bottom: 10px; }
  .cap-card p { color: var(--paper-dim); font-size: 14.5px; margin:0; }

  /* PROOF CALLOUT */
  .proof {
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-left: 3px solid var(--gold-bright);
    padding: 26px 28px;
    display:flex; gap:18px; align-items:flex-start;
    margin-top: 40px;
  }
  .proof .mark { font-family:'Fraunces',serif; font-size: 34px; color: var(--gold-bright); line-height:1; }
  .proof p { margin:0; color: var(--paper-dim); font-size: 15px; }
  .proof strong { color: var(--paper); }

  /* BOOKING */
  .book-layout { display:grid; grid-template-columns: 300px 1fr; gap: 40px; }
  .book-note { font-size: 14.5px; color: var(--paper-dim); }
  .book-note .mono-line { display:flex; gap:10px; align-items:baseline; margin-top:18px; font-size: 13px; }
  .book-note .dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; margin-top:5px; }
  .dot.open { background: var(--gold); }
  .dot.taken { background: var(--paper-dim); opacity:.4; }

  .day-col { display:flex; flex-direction:column; gap: 20px; }
  .day-block { border: 1px solid var(--line); background: var(--panel); }
  .day-block-head {
    display:flex; justify-content:space-between; align-items:baseline;
    padding: 14px 18px; border-bottom: 1px solid var(--line);
    font-family:'JetBrains Mono', monospace; font-size:13px; color: var(--gold);
  }
  .slot-row { display:grid; grid-template-columns: repeat(auto-fit, minmax(140px,1fr)); }
  .slot-btn {
    padding: 16px 18px; text-align:left; background: transparent; border: none;
    border-right: 1px solid var(--line); border-bottom: 1px solid var(--line);
    color: var(--paper); cursor:pointer; font-size: 14px;
    display:flex; flex-direction:column; gap:6px; transition: background .15s ease;
  }
  .slot-row .slot-btn:last-child { border-right:none; }
  .slot-btn:hover:not(:disabled) { background: var(--panel-2); }
  .slot-btn .t { font-family:'JetBrains Mono', monospace; font-size:14px; }
  .slot-btn .s { font-size: 11px; text-transform:uppercase; letter-spacing:.08em; color: var(--gold); }
  .slot-btn:disabled { cursor:not-allowed; opacity:.4; }
  .slot-btn:disabled .s { color: var(--paper-dim); }
  .slot-btn.selected { background: var(--gold); }
  .slot-btn.selected .t, .slot-btn.selected .s { color: var(--ink); }

  .book-form {
    margin-top: 22px; background: var(--panel); border: 1px solid var(--line);
    padding: 22px; display:none;
  }
  .book-form.show { display:block; }
  .book-form h4 { font-size: 15px; margin-bottom: 4px; }
  .book-form .selected-slot { color: var(--gold); font-family:'JetBrains Mono', monospace; font-size: 13px; margin-bottom: 16px; }
  .field { margin-bottom: 14px; }
  .field label { display:block; font-size: 12.5px; color: var(--paper-dim); margin-bottom: 6px; }
  .field input, .field textarea {
    width: 100%; background: var(--ink); border: 1px solid var(--line); color: var(--paper);
    padding: 11px 12px; font-size: 14px; border-radius: var(--radius);
  }
  .field textarea { resize: vertical; min-height: 70px; }
  .book-confirm {
    display:none; margin-top: 22px; padding: 18px 20px;
    background: rgba(201,166,107,0.1); border: 1px solid var(--gold); color: var(--paper);
    font-size: 14px;
  }
  .book-confirm.show { display:block; }
  .book-error { color: var(--gold-bright); font-size: 13px; margin-top: 8px; display:none; }
  .book-error.show { display:block; }

  /* CONTACT */
  .contact-layout { display:grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items:start; }
  .contact-form .field input, .contact-form .field textarea { background: var(--panel); }
  .contact-side p { color: var(--paper-dim); font-size: 15px; }
  .contact-side .email-line {
    margin-top: 18px; font-family:'JetBrains Mono', monospace; font-size: 15px;
    color: var(--gold); word-break: break-all;
  }
  .fallback-link { display:none; margin-top: 14px; font-size: 13px; }
  .fallback-link.show { display:block; }
  .gmb-link { display:inline-block; margin-top: 18px; font-size: 14px; color: var(--gold); text-decoration:none; border-bottom:1px solid var(--line); padding-bottom:2px; }
  .gmb-link:hover { color: var(--gold-bright); border-color: var(--gold); }

  footer { padding: 40px 0; text-align:center; color: var(--paper-dim); font-size: 13px; border-top: 1px solid var(--line); }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .facet-wrap { order:-1; }
    .cap-grid { grid-template-columns: 1fr; }
    .book-layout { grid-template-columns: 1fr; }
    .contact-layout { grid-template-columns: 1fr; }
  }
</style>

<div class="nujoom-site">

  <nav class="nav">
    <div class="nav-inner">
      <div class="brand">
        <svg class="facet-mini" viewBox="0 0 24 24" fill="none">
          <path d="M12 2L13.8 8.6L20 10L13.8 11.4L12 18L10.2 11.4L4 10L10.2 8.6L12 2Z" fill="#c9a66b"/>
          <circle cx="18.5" cy="17" r="1.6" fill="#d42a4c"/>
        </svg>
        Nujoom Digital
      </div>
      <div class="nav-links">
        <a href="#work">Services</a>
        <a href="#booking">Book a Call</a>
        <a href="#contact">Contact</a>
      </div>
    </div>
  </nav>

  <header class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Nujoom Digital · Muscat, Oman</span>
        <h1>Get online, get found, and get seen — all from one place.</h1>
        <p class="lead">We build the website and booking system, set up your Google Business listing and social accounts, shoot the photos and video that make you look the part, and offer tutoring built on real teaching experience.</p>
        <div class="hero-ctas">
          <a href="#booking" class="btn btn-primary">Book a free call</a>
          <a href="#work" class="btn btn-ghost">See our services</a>
        </div>
      </div>
      <div class="facet-wrap">
        <%= image_tag "nujoom-logo.jpg", class: "facet-gem", alt: "Nujoom Digital logo" %>
      </div>
    </div>
  </header>

  <section id="work">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Services</span>
        <h2>Three ways we help your business grow.</h2>
        <p>Whether you need a working website, a stronger presence online, or extra academic support for your kids, we build it, run it, and stay on to support it.</p>
      </div>
      <div class="cap-grid">
        <div class="cap-card">
          <svg class="cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="4" width="20" height="15" rx="1.5"/><path d="M2 8h20"/><path d="M8 13l-2 2 2 2M13 13l2 2-2 2"/></svg>
          <h3>Software Development</h3>
          <p>Custom websites, booking and scheduling systems, client portals, and business tools — built in Ruby on Rails and made to fit exactly how you work, not squeezed into a template.</p>
        </div>
        <div class="cap-card">
          <svg class="cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="4" y="7" width="16" height="12" rx="1.5"/><path d="M9 7l1.5-2.5h3L15 7"/><circle cx="12" cy="13" r="3.2"/></svg>
          <h3>Photography &amp; Production</h3>
          <p>Getting found starts with showing up right: a Google Business Profile and Maps listing, an Instagram presence, photos and video that represent you well, and the ads to put them in front of the right people.</p>
        </div>
        <div class="cap-card">
          <svg class="cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M2 8l10-4 10 4-10 4-10-4z"/><path d="M6 10.5V15c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5v-4.5"/><path d="M22 8v5.5"/></svg>
          <h3>Tutoring</h3>
          <p>One-on-one and small-group tutoring built on a strong education background — for students who need real explanations, not just answers.</p>
        </div>
      </div>

      <div class="proof">
        <span class="mark">”</span>
        <p><strong>The booking calendar below isn't a template or a Calendly embed —</strong> we built it from scratch for this site: real availability, no double-booking, no subscription fee. It's a working example of exactly what we'd build for your business.</p>
      </div>
    </div>
  </section>

  <section id="booking">
    <div class="wrap book-layout">
      <div>
        <span class="eyebrow">Book a Call</span>
        <h2 style="font-size:26px; margin-bottom:14px;">Pick a slot.</h2>
        <p class="book-note">30-minute intro call — no charge, no pressure. Times shown are Muscat time (GST).</p>
        <div class="mono-line"><span class="dot open"></span><span>Open slot</span></div>
        <div class="mono-line"><span class="dot taken"></span><span>Already booked</span></div>
      </div>

      <div>
        <div class="day-col" id="dayCol"></div>

        <div class="book-form" id="bookForm">
          <h4>Confirm your call</h4>
          <div class="selected-slot" id="selectedSlotLabel"></div>
          <div class="field">
            <label for="bkName">Name</label>
            <input id="bkName" type="text" autocomplete="name" />
          </div>
          <div class="field">
            <label for="bkEmail">Email</label>
            <input id="bkEmail" type="email" autocomplete="email" />
          </div>
          <div class="field">
            <label for="bkNote">What are you looking to build? (optional)</label>
            <textarea id="bkNote"></textarea>
          </div>
          <button class="btn btn-primary" id="bkSubmit" type="button">Confirm booking</button>
          <div class="book-error" id="bkError">Please add your name and a valid email.</div>
        </div>

        <div class="book-confirm" id="bookConfirm"></div>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap contact-layout">
      <div class="contact-side">
        <span class="eyebrow">Contact</span>
        <h2 style="font-size:26px; margin-bottom:14px;">Have a project in mind?</h2>
        <p>Tell us what you're trying to build and we'll follow up within a day or two.</p>
        <div class="email-line">mr.negm90@gmail.com</div>
        <a class="fallback-link" id="fallbackLink" href="#">Your email app didn't open? Click here to email directly →</a>
        <a class="gmb-link" href="https://maps.app.goo.gl/ite1ynLcf1CYcKJr5" target="_blank" rel="noopener">Find us on Google →</a>
      </div>
      <form class="contact-form" id="contactForm">
        <div class="field">
          <label for="cName">Name</label>
          <input id="cName" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="cEmail">Email</label>
          <input id="cEmail" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="cMessage">Message</label>
          <textarea id="cMessage" required></textarea>
        </div>
        <button class="btn btn-primary" type="submit">Send message</button>
      </form>
    </div>
  </section>

  <footer>
    © <span id="year"></span> Nujoom Digital — websites, social media, and tutoring, based in Muscat.
  </footer>
</div>

<script>
(function() {
  const root = document;
  root.getElementById('year').textContent = new Date().getFullYear();

  const TIMES = [
    { key: '10:00', label: '10:00 AM' },
    { key: '13:00', label: '1:00 PM' },
    { key: '15:30', label: '3:30 PM' },
  ];

  function nextBusinessDays(count) {
    const days = [];
    let d = new Date();
    d.setDate(d.getDate() + 1); // start tomorrow
    while (days.length < count) {
      const day = d.getDay();
      if (day !== 0 && day !== 6) {
        days.push(new Date(d));
      }
      d.setDate(d.getDate() + 1);
    }
    return days;
  }

  function fmtDate(d) {
    return d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
  }
  function isoDate(d) {
    return d.toISOString().slice(0, 10);
  }

  const days = nextBusinessDays(6);
  const dayCol = root.getElementById('dayCol');
  let bookings = [];
  let selected = null; // { date, time, label }

  function slotTaken(dateIso, timeKey) {
    return bookings.some(b => b.date === dateIso && b.time === timeKey);
  }

  function render() {
    dayCol.innerHTML = '';
    days.forEach(d => {
      const iso = isoDate(d);
      const block = document.createElement('div');
      block.className = 'day-block';

      const head = document.createElement('div');
      head.className = 'day-block-head';
      head.innerHTML = `<span>${fmtDate(d)}</span>`;
      block.appendChild(head);

      const row = document.createElement('div');
      row.className = 'slot-row';

      TIMES.forEach(t => {
        const taken = slotTaken(iso, t.key);
        const btn = document.createElement('button');
        btn.className = 'slot-btn';
        btn.disabled = taken;
        btn.innerHTML = `<span class="t mono">${t.label}</span><span class="s">${taken ? 'Booked' : 'Open'}</span>`;
        if (selected && selected.date === iso && selected.time === t.key) {
          btn.classList.add('selected');
        }
        btn.addEventListener('click', () => {
          selected = { date: iso, time: t.key, label: `${fmtDate(d)} · ${t.label} GST` };
          render();
          showForm();
        });
        row.appendChild(btn);
      });

      block.appendChild(row);
      dayCol.appendChild(block);
    });
  }

  const bookForm = root.getElementById('bookForm');
  const selectedSlotLabel = root.getElementById('selectedSlotLabel');
  const bkError = root.getElementById('bkError');
  const bookConfirm = root.getElementById('bookConfirm');

  function showForm() {
    bookForm.classList.add('show');
    bookConfirm.classList.remove('show');
    bkError.classList.remove('show');
    selectedSlotLabel.textContent = selected.label;
    bookForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  async function loadBookings() {
    bookings = [];
    render();
  }
  
  root.getElementById('bkSubmit').addEventListener('click', async () => {
    const name = root.getElementById('bkName').value.trim();
    const email = root.getElementById('bkEmail').value.trim();
    const note = root.getElementById('bkNote').value.trim();
    const emailOk = /\S+@\S+\.\S+/.test(email);

    if (!name || !emailOk || !selected) {
      bkError.classList.add('show');
      return;
    }
    bkError.classList.remove('show');

    if (slotTaken(selected.date, selected.time)) {
      bkError.textContent = 'Sorry — that slot was just taken. Pick another.';
      bkError.classList.add('show');
      selected = null;
      render();
      bookForm.classList.remove('show');
      return;
    }

    bookings.push({
      date: selected.date,
      time: selected.time,
      name, email, note,
      bookedAt: new Date().toISOString()
    });

    bookConfirm.textContent = `You're booked for ${selected.label}. A confirmation would normally be emailed to ${email} — for now, reach out at mr.negm90@gmail.com to lock it in on our end.`;
    bookConfirm.classList.add('show');
    bookForm.classList.remove('show');
    root.getElementById('bkName').value = '';
    root.getElementById('bkEmail').value = '';
    root.getElementById('bkNote').value = '';
    selected = null;
    render();
  });

  loadBookings();

  // Contact form → mailto
  const contactForm = root.getElementById('contactForm');
  const fallbackLink = root.getElementById('fallbackLink');
  contactForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = root.getElementById('cName').value.trim();
    const email = root.getElementById('cEmail').value.trim();
    const message = root.getElementById('cMessage').value.trim();
    if (!name || !email || !message) return;

    const subject = encodeURIComponent(`New project inquiry from ${name}`);
    const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`);
    const mailto = `mailto:mr.negm90@gmail.com?subject=${subject}&body=${body}`;

    window.open(mailto, '_blank');
    fallbackLink.href = mailto;
    fallbackLink.classList.add('show');
  });
})();
</script>